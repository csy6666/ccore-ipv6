[Unit]
Description=ccore-ipv6 local address restore API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ccore-ipv6
Group=ccore-ipv6
ExecStartPre=/usr/local/bin/ccore-ipv6 restore --state /var/lib/ccore-ipv6/state.json
ExecStart=/usr/local/bin/ccore-ipv6 serve --socket /run/ccore-ipv6/ccore-ipv6.sock --state /var/lib/ccore-ipv6/state.json
EnvironmentFile=-/etc/ccore-ipv6/cloudflare.env
Restart=on-failure
RestartSec=3s
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
UMask=0077
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
ReadWritePaths=/run/ccore-ipv6 /var/lib/ccore-ipv6
RuntimeDirectory=ccore-ipv6
StateDirectory=ccore-ipv6
StateDirectoryMode=2750

[Install]
WantedBy=multi-user.target
